# Stride Backend Production Environment Template
NODE_ENV=production
PORT=4000

# OpenRouter AI Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Host Server Configuration (for the setup script)
PROJECT_USER=stride_admin
PROJECT_DIR=/home/stride_admin/app
